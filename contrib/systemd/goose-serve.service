[Unit]
Description=Goose ACP Backend Server
Documentation=https://github.com/aaif-goose/goose
After=network.target
# Restart cleanly when SSH session ends (SIGHUP does not kill service)

[Service]
Type=simple
# SECURITY WARNING: --dangerously-unauthenticated binds the ACP server to TCP
# 127.0.0.1:3284 with no authentication. Any local user on this machine can
# connect and execute commands via the agent's tools. Only deploy on machines
# where you are the sole user, or where localhost is trusted (e.g., inside a
# private VM or container). A future improvement will bind to a Unix domain
# socket at /run/user/<uid>/goose-acp.sock with 0600 permissions instead.
ExecStart=%h/.local/bin/goose serve --host 127.0.0.1 --port 3284 --dangerously-unauthenticated
Restart=on-failure
RestartSec=5
Environment=GOOSE_LOG=info
# Ensure service survives SSH session end
KillMode=process

[Install]
WantedBy=default.target
